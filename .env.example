# ==============================================================================
# MEMORIA'26 TICKETING SYSTEM — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_PATH=./data/memoria.db

# Security & Tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
QR_SECRET=replace_with_a_cryptographically_secure_qr_secret_in_production
AUTH_TOKEN_EXPIRY=7d

# Pricing (Authoritative Backend-Controlled, integer LKR)
UNIVERSITY_TICKET_PRICE=200
OUTSIDER_TICKET_PRICE=1000

# File Uploads (Bank Payment Slips)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880

# CORS & Frontend URL
FRONTEND_URL=http://localhost:5173

# Email Service (SMTP - Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Memoria'26 Ticketing Desk <tickets@memoria.lk>"
SMTP_SECURE=false
